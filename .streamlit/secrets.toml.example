# Copia questo file in ".streamlit/secrets.toml" (già ignorato da git) per lo
# sviluppo locale, oppure incolla lo stesso contenuto nei "Secrets" della tua
# app su Streamlit Community Cloud.
#
# La stringa di connessione si trova su Supabase:
#   Project → Settings → Database → Connection string → "Connection pooling"
# Usa la URI del POOLER (compatibile con Streamlit Cloud) e sostituisci
# [YOUR-PASSWORD] con la password del database.

[supabase]
db_url = "postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
